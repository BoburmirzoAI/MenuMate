# Menu Mate Admin — muhit o'zgaruvchilari
# `cp .env.example .env` va o'zingizga mos qiymatlarni qo'ying.

# Backend API bosh URL (Vite dev-server o'zi proksi qiladi, prod'da to'liq URL kerak)
VITE_API_BASE_URL=/api/v1

# Til (default: uz | qo'llab-quvvatlanadigan: uz, ru, en)
VITE_DEFAULT_LANGUAGE=uz
