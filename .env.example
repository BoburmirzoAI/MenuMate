# Menu Mate — Root .env template
# Copy to `.env` va o'zingizning qiymatlaringiz bilan to'ldiring.
# docker-compose.yml shu fayldan o'qiydi.

# --- Django ---
SECRET_KEY=change-me-to-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DB_NAME=menu_mate
DB_USER=menu_mate
DB_PASSWORD=menu_mate_pass
DB_HOST=db
DB_PORT=5432

# --- External APIs ---
OPENWEATHER_API_KEY=
FCM_SERVER_KEY=

# --- Karzinka Go (Yandex Lavka B2B, ixtiyoriy) ---
# Bo'sh qoldirsangiz — faqat ochiq Karzinka API (223 promo mahsulot) ishlaydi.
# Lavka orqali 5000+ mahsulot uchun Proxyman + iPhone Karzinka Go orqali
# webviewtoken cookie'ni oling. Token ~1 soatda tugaydi.
KARZINKA_LAVKA_TOKEN=
KARZINKA_LAVKA_YAUID=
KARZINKA_LAVKA_GEOID=
KARZINKA_LAVKA_SESSION_ID=
KARZINKA_LAVKA_LAT=41.2694820819372
KARZINKA_LAVKA_LON=69.24657079428343

# --- Telegram (optional, error alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
